<script>
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var nav = document.getElementById('nav');
  window.addEventListener('scroll', function () {
    if (window.scrollY > 12) { nav.classList.add('shadow-soft'); }
    else { nav.classList.remove('shadow-soft'); }
  });

  var menuBtn = document.getElementById('menuBtn');
  var mobileMenu = document.getElementById('mobileMenu');
  var iconOpen = document.getElementById('menuIconOpen');
  var iconClose = document.getElementById('menuIconClose');
  menuBtn.addEventListener('click', function () {
    var isOpen = !mobileMenu.classList.contains('hidden');
    mobileMenu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', String(!isOpen));
  });
  mobileMenu.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      mobileMenu.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    });
  });

  var revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && !reduceMotion) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); io.unobserve(entry.target); }
      });
    }, { threshold: 0.15 });
    revealEls.forEach(function (el) { io.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
  }

  // Quality-control checklist: staggered tick-off, then a stamp pops in
  (function () {
    var card = document.getElementById('qcCard');
    var items = document.querySelectorAll('#qcList .qc-item');
    var stamp = document.getElementById('qcStamp');
    var played = false;

    function play() {
      if (played) return;
      played = true;
      if (reduceMotion) {
        items.forEach(function (item) {
          item.classList.add('on');
          item.querySelector('.qc-box').classList.add('on');
          item.querySelector('.qc-check').classList.add('on');
        });
        stamp.classList.add('on');
        return;
      }
      items.forEach(function (item, i) {
        setTimeout(function () {
          item.classList.add('on');
          item.querySelector('.qc-box').classList.add('on');
          item.querySelector('.qc-check').classList.add('on');
        }, i * 110);
      });
      setTimeout(function () { stamp.classList.add('on'); }, items.length * 110 + 250);
    }

    var io2 = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { if (entry.isIntersecting) { play(); io2.unobserve(entry.target); } });
    }, { threshold: 0.35 });
    io2.observe(card);
  })();

  // Stat counters
  (function () {
    var counters = document.querySelectorAll('.counter');
    if (!counters.length) return;
    function animate(el) {
      var target = parseInt(el.getAttribute('data-target'), 10);
      if (reduceMotion) { el.textContent = target; return; }
      var duration = 1200, startTime = null;
      function step(ts) {
        if (!startTime) startTime = ts;
        var progress = Math.min((ts - startTime) / duration, 1);
        el.textContent = Math.round(progress * target);
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    var io3 = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { if (entry.isIntersecting) { animate(entry.target); io3.unobserve(entry.target); } });
    }, { threshold: 0.5 });
    counters.forEach(function (c) { io3.observe(c); });
  })();

  // Free tools: tab switching
  (function () {
    var tabs = document.querySelectorAll('.tool-tab');
    var panels = { stain: document.getElementById('panel-stain'), estimate: document.getElementById('panel-estimate') };
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        tabs.forEach(function (t) {
          t.classList.remove('active', 'bg-brand-600', 'text-white');
          t.classList.add('text-ink/55');
        });
        tab.classList.add('active', 'bg-brand-600', 'text-white');
        tab.classList.remove('text-ink/55');
        Object.keys(panels).forEach(function (key) { panels[key].classList.add('hidden'); });
        panels[tab.getAttribute('data-tab')].classList.remove('hidden');
      });
    });
  })();

  // Ask Kaz — client-side demo only, no external API / no exposed keys.
  // In production, call your own server route that holds the model key server-side.
  (function () {
    var tips = {
      wine: "Blot (don't rub) with a clean cloth immediately. Apply cold water, then a little dish soap mixed with hydrogen peroxide. Blot again and rinse.",
      oil: "Sprinkle cornstarch or baking soda on the fresh stain, let sit 15 minutes to absorb, then brush off and wash with dish soap and warm water.",
      ink: "Dab (don't rub) with rubbing alcohol on a cotton pad from the outside in, then wash as usual. Test on a hidden spot first.",
      coffee: "Rinse the back of the fabric with cool water, then treat with a mix of white vinegar, dish soap, and water before washing.",
      blood: "Use only cold water — never hot. Soak, then gently work in a little salt or dish soap before rinsing.",
      grass: "Apply rubbing alcohol or a vinegar solution, let sit 10 minutes, then blot and wash with an enzyme detergent.",
    };
    var btn = document.getElementById('stainBtn');
    var btnText = document.getElementById('stainBtnText');
    var input = document.getElementById('stainInput');
    var resultBox = document.getElementById('stainResult');
    var content = document.getElementById('stainContent');

    btn.addEventListener('click', function () {
      var val = (input.value || '').toLowerCase().trim();
      if (!val) return;
      btn.disabled = true;
      btnText.textContent = 'Thinking…';
      setTimeout(function () {
        var match = Object.keys(tips).find(function (k) { return val.indexOf(k) !== -1; });
        content.textContent = match
          ? tips[match]
          : "Blot (never rub) excess liquid right away, treat with a mild soap-and-cold-water solution, and avoid heat until the stain is fully out. Book a visit if it's set in.";
        resultBox.classList.remove('hidden');
        btn.disabled = false;
        btnText.textContent = 'Get instant advice';
      }, 700);
    });
  })();

  // Instant Estimate — illustrative pricing only; replace with real rates.
  (function () {
    var state = { type: 'Apartment', rooms: 2, service: 'standard' };
    var base = { Apartment: 15000, House: 20000, Office: 25000 };
    var perRoom = { Apartment: 4000, House: 5000, Office: 6000 };

    function wirePillGroup(containerId, onPick) {
      var group = document.getElementById(containerId);
      group.querySelectorAll('.est-pill').forEach(function (pill) {
        pill.addEventListener('click', function () {
          group.querySelectorAll('.est-pill').forEach(function (p) {
            p.classList.remove('active', 'bg-brand-600', 'text-white');
            p.classList.add('bg-white/70', 'text-ink/60', 'border', 'border-white/80');
          });
          pill.classList.add('active', 'bg-brand-600', 'text-white');
          pill.classList.remove('bg-white/70', 'text-ink/60', 'border', 'border-white/80');
          onPick(pill.getAttribute('data-val'));
        });
      });
    }
    wirePillGroup('estType', function (v) { state.type = v; });
    wirePillGroup('estRooms', function (v) { state.rooms = parseInt(v, 10); });
    wirePillGroup('estService', function (v) { state.service = v; });

    document.getElementById('estBtn').addEventListener('click', function () {
      var amount = base[state.type] + state.rooms * perRoom[state.type];
      if (state.service === 'deep') amount *= 1.4;
      var low = Math.round((amount * 0.9) / 500) * 500;
      var high = Math.round((amount * 1.15) / 500) * 500;
      var hours = Math.round((1.5 + state.rooms * 0.6) * (state.service === 'deep' ? 1.3 : 1) * 10) / 10;

      document.getElementById('estPrice').textContent =
        '₦' + low.toLocaleString('en-NG') + ' – ₦' + high.toLocaleString('en-NG');
      document.getElementById('estMeta').textContent =
        'Roughly ' + hours + ' hours on site · ' + state.type.toLowerCase() + ', ' + state.rooms + ' room(s), ' + (state.service === 'deep' ? 'deep clean' : 'standard clean');
      document.getElementById('estResult').classList.remove('hidden');
    });
  })();
</script>
