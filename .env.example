# ==============================================================================
# KazKleen Production Environment Variables
# Duplicate this file to .env.local for local development.
# Configure these variables in Vercel under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY AI PROVIDER: Vercel AI Gateway
# ------------------------------------------------------------------------------
# Default Gateway endpoint for routing requests
AI_GATEWAY_URL="https://gateway.ai.vercel.store/v1/chat/completions"

# Your Vercel AI Gateway API key or OIDC token
# Obtain from your Vercel Dashboard -> AI Gateway settings
AI_GATEWAY_API_KEY="your_vercel_ai_gateway_api_key_here"

# ------------------------------------------------------------------------------
# 2. SECONDARY AI PROVIDER: Google Gemini AI Studio (Fallback)
# ------------------------------------------------------------------------------
# Your Google Gemini API Studio key (used if the primary AI Gateway times out or fails)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_google_ai_studio_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. SITE METADATA & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://kazkleen.com"

# ------------------------------------------------------------------------------
# 4. CONTACT & FORM NOTIFICATIONS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL="kazkleen@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE="+2349046042275"